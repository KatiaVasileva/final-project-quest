<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. ТАБЛИЦА ПОЛЬЗОВАТЕЛЕЙ -->
    <changeSet id="1" author="vasileva">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="login" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 2. ТАБЛИЦА СТАТИСТИКИ (One-to-One к Users) -->
    <changeSet id="2" author="vasileva">
        <createTable tableName="user_stats">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_user_stats_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="total" type="INT" defaultValueNumeric="0"/>
            <column name="wins" type="INT" defaultValueNumeric="0"/>
            <column name="losses" type="INT" defaultValueNumeric="0"/>
        </createTable>
    </changeSet>

    <!-- 3. ТАБЛИЦА КВЕСТОВ -->
    <changeSet id="3" author="vasileva">
        <createTable tableName="quests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="text" type="TEXT"/>
            <column name="start_question_id" type="BIGINT"/>
            <column name="image" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- 4. ТАБЛИЦА ВОПРОСОВ (Many-to-One к Quests) -->
    <changeSet id="4" author="vasileva">
        <createTable tableName="questions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(255)"/>
            <column name="text" type="VARCHAR(1000)"/>
            <column name="quest_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_questions_quest" referencedTableName="quests" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 5. ТАБЛИЦА ОТВЕТОВ (Many-to-One к Questions) -->
    <changeSet id="5" author="vasileva">
        <createTable tableName="answers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="question_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_answers_question" referencedTableName="questions" referencedColumnNames="id"/>
            </column>
            <column name="next_question_label" type="VARCHAR(255)"/>
            <column name="text" type="VARCHAR(1000)"/>
            <column name="description" type="VARCHAR(1000)"/>
        </createTable>
    </changeSet>

    <!-- 6. ТАБЛИЦА ИГРОВЫХ СОСТОЯНИЙ (Связи с Quests, Questions и Users) -->
    <changeSet id="6" author="vasileva">
        <createTable tableName="game_states">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quest_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_game_states_quest" referencedTableName="quests" referencedColumnNames="id"/>
            </column>
            <column name="question_id" type="BIGINT">
                <constraints foreignKeyName="fk_game_states_question" referencedTableName="questions" referencedColumnNames="id"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_game_states_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="is_completed" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <!-- 7. ТАБЛИЦА ИГР (История/Лог) -->
    <changeSet id="7" author="vasileva">
        <createTable tableName="games">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quest_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_games_quest" referencedTableName="quests" referencedColumnNames="id"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_games_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="current_question_id" type="BIGINT"/>
            <column name="game_state_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_games_game_state" referencedTableName="game_states" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
